<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8">
    <title>プロフィール詳細 - Match Log</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="manifest" href="manifest.json">
    <link rel="stylesheet" href="dashboard.css">
    <!-- Supabase client library and initialization -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="supabaseClient.js"></script>
    <script defer src="profile-detail.js"></script>
  </head>
  <body>
    <div class="app-container">
      <header class="glass-header">
        <div class="header-left">
          <img src="icons/calendar_logo_colorful.svg" alt="logo" class="logo-icon">
          <span class="app-title">Match L<span style="color:#D4869C;">o</span><span style="color:#7BA7D1;">g</span></span>
        </div>
        <button class="pill-btn" onclick="logout()">ログアウト</button>
      </header>

      <main class="main-content">
        <section id="detail-section">
        </section>
        <section id="detail-buttons" style="display:none;">
        </section>
      </main>

      <nav class="bottom-nav">
        <a href="index.html" class="nav-btn">
          <img src="icons/home.svg" alt="ホーム" class="nav-icon-img">
          <span class="nav-label">ホーム</span>
        </a>
        <a href="profiles.html" class="nav-btn active">
          <img src="icons/profiles.svg" alt="相手" class="nav-icon-img">
          <span class="nav-label">相手</span>
        </a>
        <a href="events.html" class="nav-btn">
          <img src="icons/plus.svg" alt="登録" class="nav-icon-img">
          <span class="nav-label">登録</span>
        </a>
        <a href="calendar.html" class="nav-btn">
          <img src="icons/battle.svg" alt="戦歴" class="nav-icon-img">
          <span class="nav-label">戦歴</span>
        </a>
        <a href="account.html" class="nav-btn">
          <img src="icons/settings.svg" alt="設定" class="nav-icon-img">
          <span class="nav-label">設定</span>
        </a>
      </nav>
    </div>
  </body>
</html>